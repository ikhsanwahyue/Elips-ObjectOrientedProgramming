  <diagram id="flow-bendageometri-rumus" name="Cabang Rumus Subclass">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" value="Cabang Rumus Class Turunan BendaGeometri" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_note" value="Halaman ini merinci implementasi hitungLuas(), hitungKeliling(), dan hitungVolume() pada package pElips.model. Tidak ada alur MainFrame.java." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="990" y="70" width="520" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2_start" value="Mulai rumus subclass" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="95" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2_select" value="Jenis objek turunan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#a21caf;fontColor=#581c87;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="170" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2_base" value="BendaGeometri (abstract, Runnable)&#xa;- hitungSemua(): luas -&gt; keliling -&gt; volume&#xa;- run(): loop 1000x + progress/status&#xa;- utility: wajibPositif(), validasi(), akarKuadrat(), pangkat(), formatAngka()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="250" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p2_elips" value="Elips extends BendaGeometri&#xa;Input: a,b &gt; 0&#xa;Luas = PI * a * b&#xa;Keliling = PI * (3(a+b) - sqrt((3a+b)(a+3b)))&#xa;Volume = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="85" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2_bola" value="Bola extends BendaGeometri&#xa;Input: r &gt; 0&#xa;Diameter = 2r&#xa;Luas permukaan = 4 * PI * r^2&#xa;Keliling lingkaran besar = 2 * PI * r&#xa;Volume = (4/3) * PI * r^3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;fontColor=#365314;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="85" width="460" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p2_tabung" value="Tabung extends Bola&#xa;Input: r,t &gt; 0&#xa;Luas alas = PI * r^2&#xa;Luas selimut = 2 * PI * r * t&#xa;Luas permukaan = 2 * luasAlas + luasSelimut&#xa;Keliling = 2 * PI * r&#xa;Volume = luasAlas * t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="420" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p2_cincin" value="Cincin extends Bola&#xa;Input: R,r &gt; 0 dan R &gt; r&#xa;Keliling mayor = 2 * PI * R&#xa;Luas = 4 * PI^2 * R * r&#xa;Volume = 2 * PI^2 * R * r^2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="300" width="460" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2_juring" value="Juring extends Bola&#xa;Input: r,h &gt; 0 dan h &lt;= 2r&#xa;Jari-jari alas = sqrt(h * (2r - h))&#xa;Luas alas = PI * jariJariAlas^2&#xa;Luas = luasAlas + PI * r * h&#xa;Keliling alas = 2 * PI * jariJariAlas&#xa;Volume = (2/3) * PI * r^2 * h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="540" width="420" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p2_tembereng" value="Tembereng extends Bola&#xa;Input: r,h &gt; 0 dan h &lt;= 2r&#xa;Jari-jari alas = sqrt(h * (2r - h))&#xa;Luas selimut = 2 * PI * r * h&#xa;Luas alas = PI * jariJariAlas^2&#xa;Luas = luasSelimut + luasAlas&#xa;Keliling alas = 2 * PI * jariJariAlas&#xa;Volume = (PI * h^2 / 3) * (3r - h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#831843;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="540" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p2_kerucut" value="KerucutDenganAlasElips extends Elips&#xa;Input: a,b,t &gt; 0&#xa;Luas alas = PI * a * b&#xa;gA = sqrt(a^2 + t^2), gB = sqrt(b^2 + t^2)&#xa;Luas selimut = PI * (a*gB + b*gA) / 2&#xa;Luas permukaan = luasAlas + luasSelimut&#xa;Keliling = keliling elips&#xa;Volume = (1/3) * luasAlas * t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0d9488;fontColor=#134e4a;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="805" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p2_frustum" value="KerucutTerpancungDenganAlasElips extends Elips&#xa;Input: a1,b1,a2,b2,t &gt; 0; a2 &lt; a1; b2 &lt; b1&#xa;Luas bawah = PI * a1 * b1; luas atas = PI * a2 * b2&#xa;Keliling bawah/atas = rumus keliling elips&#xa;diffA = a1 - a2; diffB = b1 - b2&#xa;g = sqrt(t^2 + (diffA^2 + diffB^2) / 2)&#xa;Luas selimut = 0.5 * (kelilingBawah + kelilingAtas) * g&#xa;Luas = luasBawah + luasAtas + luasSelimut&#xa;Keliling = kelilingBawah + kelilingAtas&#xa;Volume = (t/3) * (luasBawah + luasAtas + sqrt(luasBawah * luasAtas))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="805" width="540" height="285" as="geometry" />
        </mxCell>
        <mxCell id="p2_result" value="Return hasil ke field hasil&#xa;luas2 / keliling2 / volume2&#xa;lalu disalin ke luas / keliling / volume" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="575" y="1135" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="p2_start" target="p2_select">
